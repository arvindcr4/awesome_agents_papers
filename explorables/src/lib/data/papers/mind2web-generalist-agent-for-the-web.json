{
  "title": "Mind2Web: A Generalist Agent for the Web",
  "authors": [
    "Xiang Deng",
    "Yu Gu",
    "Boyuan Zheng",
    "Shijie Chen",
    "Samuel Stevens",
    "Boshi Wang",
    "Huan Sun",
