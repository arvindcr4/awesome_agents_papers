{
  "title": "VisualWebArena: Evaluating Multimodal Agents on Realistic Visually Grounded Web Tasks",
  "authors": [
    "Jing Yu Koh",
    "Robert Lo",
    "Lawrence Jang",
    "Vikram Duvvur",
    "Ming Chong Lim",
    "Po-Yu Huang",
    "Graham Neubig",
