{
  "title": "miniCTX: Neural Theorem Proving with Long-Contexts",
  "authors": [
    "Jiewen Hu",
    "Thomas Zhu",
    "Sean Welleck"
  ],
  "year": 2025,
  "arxivId": "2408.03350",
  "abstract": "The miniCTX benchmark evaluates neural theorem provers in real-world settings where proofs depend on new definitions, lemmas, and context from formal projects. It introduces a unique challenge by requiring models to reason over long contexts and handle dependencies that arise in real-world theorem proving tasks.",
  "sections": [
    {
      "title": "The Core Idea",
      "content": "Theorem proving in real-world settings often depends on a wealth of context, including definitions, lemmas, comments, and file structure. <strong>Context-dependent theorem proving</strong> aims to generate proofs for new theorems based on this context. The <strong>miniCTX benchmark</strong> is designed to evaluate this ability, using real-world, complex theorems from various Lean projects.",
      "visualization": {
        "type": "flow-diagram",
