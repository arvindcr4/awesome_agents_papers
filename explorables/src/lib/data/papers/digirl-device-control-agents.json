{
  "title": "DigiRL: Training In-The-Wild Device-Control Agents with Autonomous Reinforcement Learning",
  "authors": [
    "Hao Bai",
    "Yifei Zhou",
    "Mert Cemri",
    "Jiayi Pan",
    "Alane Suhr",
    "Sergey Levine",
    "Aviral Kumar"
  ],
  "year": 2024,
  "arxivId": "2406.11896",
  "abstract": "DigiRL is a novel autonomous reinforcement learning approach for training device-control agents. It fine-tunes a pre-trained vision-language model in two stages: offline RL to initialize the model, followed by offline-to-online RL. This approach enables the agent to learn from its own experience and adapt to real-world stochasticity and non-stationarity, outperforming prior state-of-the-art methods on Android device-control tasks.",
  "sections": [
    {
      "title": "The Core Idea",
      "content": "DigiRL addresses the limitations of pre-trained vision-language models (VLMs) in controlling devices through graphical user interfaces (GUIs). <strong>VLMs</strong> excel in reasoning and common-sense tasks but struggle with decision-making and device control due to the lack of sufficient decision-centric data in their training corpora. DigiRL proposes a two-stage approach: <strong>offline RL</strong> to initialize the model using existing data, followed by <strong>offline-to-online RL</strong> to fine-tune the model through online interaction.",
      "visualization": {
        "type": "flow-diagram",
        "description": "A flow diagram showing the two-stage approach of DigiRL, with offline RL followed by offline-to-online RL.",
