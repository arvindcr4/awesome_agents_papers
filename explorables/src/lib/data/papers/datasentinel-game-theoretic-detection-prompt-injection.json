{
  "title": "DataSentinel: A Game-Theoretic Detection of Prompt Injection Attacks",
  "authors": [
    "Yupei Liu",
    "Yuqi Jia",
    "Jinyuan Jia",
    "Dawn Song",
    "Neil Zhenqiang Gong"
  ],
  "year": 2025,
  "arxivId": "2504.11358",
  "abstract": "DataSentinel is a game-theoretic method to detect prompt injection attacks in LLM-integrated applications. It fine-tunes a detection LLM to detect inputs contaminated with injected prompts that are strategically adapted to evade detection. DataSentinel simulates a game between the detector and the attacker, where the detector aims to detect contaminated target data, and the attacker aims to evade detection and mislead the backend LLM into performing an injected task.",
  "sections": [
    {
      "title": "The Core Idea",
      "content": "DataSentinel is a <strong>game-theoretic method</strong> that detects prompt injection attacks by fine-tuning a detection LLM to detect contaminated target data. The detection LLM is fine-tuned using a dataset of contaminated and clean target data, and it leverages a detection instruction with a ground-truth answer known to the defender but not attackers.",
      "visualization": {
        "type": "flow-diagram",
