{
  "title": "MasRouter: Learning to Route LLMs for Multi-Agent Systems",
  "authors": [
    "Yanwei Yue",
    "Guibin Zhang",
    "Boyang Liu",
    "Guancheng Wan",
    "Kun Wang",
    "Dawei Cheng",
    "Yiyan Qi"
  ],
  "year": 2025,
  "arxivId": "2502.11133",
  "abstract": "MasRouter is a multi-agent system routing framework that integrates collaboration mode determination, role allocation, and LLM routing to balance effectiveness and efficiency. It constructs a task-adaptive multi-agent system that can seamlessly combine with mainstream multi-agent systems, reducing overhead by up to 52.07% and achieving a 1.8% \u223c 8.2% improvement over state-of-the-art methods.",
  "sections": [
    {
      "title": "The Core Idea",
      "content": "The core idea of MasRouter is to customize a multi-agent system (MAS) for a given query by determining the collaboration mode, allocating roles to agents, and routing each agent to an appropriate Large Language Model (LLM). This approach enables the MAS to balance effectiveness and efficiency, outperforming single-agent systems and reducing unnecessary overhead.",
