{
  "title": "Paper2Agent: Turning Research Papers into Interactive AI Agents",
  "authors": [
    "Jiacheng Miao",
    "Joe R. Davis",
    "Yaohui Zhang",
    "Jonathan K. Pritchard",
    "James Zou"
  ],
  "year": 2025,
  "arxivId": "2509.06917",
  "abstract": "Paper2Agent is a framework that converts research papers into interactive AI agents, making it easier for scientists to apply methods and tools from published papers to their own work. By automating the process of understanding and adapting a paper's code, data, and methods, Paper2Agent accelerates scientific discovery and collaboration.",
  "sections": [
    {
      "title": "The Core Idea",
      "content": "Paper2Agent takes a research paper and **automatically generates an AI agent** that embodies the knowledge and methods described in the paper. This agent can be interacted with through natural language, allowing scientists to **apply the paper's methods to new data** and **ask questions** about the research without needing to understand the underlying code or technical details.",
      "visualization": {
        "type": "flow-diagram",
