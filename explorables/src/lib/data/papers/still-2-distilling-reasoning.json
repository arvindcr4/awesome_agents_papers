{
  "title": "Scaling up Test-Time Compute with Latent Reasoning: A Recurrent Depth Approach",
  "authors": [
    "Jonas Geiping",
    "Sean McLeish",
    "Neel Jain",
    "John Kirchenbauer",
    "Siddharth Singh",
    "Brian R. Bartoldson",
    "Bhavya Kailkhura",
