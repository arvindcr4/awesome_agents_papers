{
  "title": "Extracting Training Data from Large Language Models",
  "authors": [
    "Nicholas Carlini",
    "Florian Tram\u00e8r",
    "Eric Wallace",
    "Matthew Jagielski",
    "Ariel Herbert-Voss",
