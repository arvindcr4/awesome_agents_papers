{
  "title": "O1 Replication Journey: A Strategic Progress Report",
  "authors": [
    "Yiwei Qin",
    "Xuefeng Li",
    "Haoyang Zou",
    "Yixiu Liu",
    "Shijie Xia",
    "Zhen Huang",
