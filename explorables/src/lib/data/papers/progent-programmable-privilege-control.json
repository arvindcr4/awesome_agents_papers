{
  "title": "Progent: Programmable Privilege Control for LLM Agents",
  "authors": [
    "Tianneng Shi",
    "Jingxuan He",
    "Zhun Wang",
    "Hongwei Li",
    "Linyu Wu",
    "Wenbo Guo",
    "Dawn Song"
