{
  "title": "WebAgent-R1: End-to-End Multi-Turn Reinforcement Learning for Web Agents",
  "authors": [
    "Zhepei Wei",
    "Wenlin Yao",
    "Yao Liu",
    "Weizhi Zhang",
    "Qin Lu",
    "Liang Qiu",
    "Changlong Yu",
