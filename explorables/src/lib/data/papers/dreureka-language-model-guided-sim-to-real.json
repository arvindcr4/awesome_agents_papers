{
  "title": "DrEureka: Language Model Guided Sim-To-Real Transfer",
  "authors": [
    "Yecheng Jason Ma",
    "William Liang",
    "Hung-Ju Wang",
    "Sam Wang",
    "Yuke Zhu",
    "Linxi 'Jim' Fan",
    "Osbert Bastani",
    "Dinesh Jayaraman"
