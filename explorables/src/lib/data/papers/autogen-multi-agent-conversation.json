{
  "title": "AutoGen: Enabling Next-Gen LLM Applications via Multi-Agent Conversation",
  "authors": [
    "Qingyun Wu",
    "Gagan Bansal",
    "Jieyu Zhang",
    "Yiran Wu",
    "Beibin Li",
    "Erkang Zhu",
    "Li Jiang",
    "Xiaoyun Zhang",
    "Shaokun Zhang",
