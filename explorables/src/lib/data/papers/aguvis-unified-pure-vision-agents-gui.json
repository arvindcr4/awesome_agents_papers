{
  "title": "AGUVIS: Unified Pure Vision Agents for Autonomous GUI Interaction",
  "authors": [
    "Yiheng Xu",
    "Zekun Wang",
    "Junli Wang",
    "Dunjie Lu",
    "Tianbao Xie",
    "Amrita Saha",
    "Doyen Sahoo",
